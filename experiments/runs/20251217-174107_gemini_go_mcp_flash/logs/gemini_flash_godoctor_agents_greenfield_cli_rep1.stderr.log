// captureOutput captures stdout and stderr.
func captureOutput(f func()) (string, string) {
	oldStdout := os.Stdout
	oldStderr := os.Stderr

	r, w, _ := os.Pipe()
	os.Stdout = w
	os.Stderr = w // Redirect stderr to also capture

	f()

	w.Close()

	out, _ := ioutil.ReadAll(r)

	os.Stdout = oldStdout
	os.Stderr = oldStderr

	return string(out), string(out) // Return both as string, since stderr is redirected to stdout
}

func TestLoadAndSaveTasks(t *testing.T) {
	setupTestEnvironment()
	defer teardownTestEnvironment()

	// Test saving and loading empty list
	emptyTasks := []Task{}
	err := SaveTasks(emptyTasks)
	if err != nil {
		t.Fatalf("SaveTasks failed for empty list: %v", err)
	}

	loadedTasks, err := LoadTasks()
	if err != nil {
		t.Fatalf("LoadTasks failed for empty list: %v", err)
	}
	if len(loadedTasks) != 0 {
		t.Errorf("Expected 0 tasks, got %d", len(loadedTasks))
	}

	// Test saving and loading tasks
	tasks := []Task{
		{ID: 1, Description: "Task 1", Done: false},
		{ID: 2, Description: "Task 2", Done: true},
	}
	err = SaveTasks(tasks)
	if err != nil {
		t.Fatalf("SaveTasks failed: %v", err)
	}

	loadedTasks, err = LoadTasks()
	if err != nil {
		t.Fatalf("LoadTasks failed: %v", err)
	}
	if len(loadedTasks) != 2 {
		t.Errorf("Expected 2 tasks, got %d", len(loadedTasks))
	}
	if loadedTasks[0].ID != 1 || loadedTasks[1].ID != 2 {
		t.Errorf("Loaded tasks do not match expected IDs")
	}
}

func TestAddCommand(t *testing.T) {
	setupTestEnvironment()
	defer teardownTestEnvironment()

	// Test adding a single task
	os.Args = []string{"cmd", "add", "-description", "Buy milk"}
	out, _ := captureOutput(main)

	expected := `{"id":1,"status":"added"}
`
	if out != expected {
		t.Errorf("Expected %q, got %q", expected, out)
	}

	// Verify task is saved
	tasks, _ := LoadTasks()
	if len(tasks) != 1 || tasks[0].Description != "Buy milk" || tasks[0].ID != 1 {
		t.Errorf("Task not saved correctly: %+v", tasks)
	}

	// Test adding another task, checking ID generation
	os.Args = []string{"cmd", "add", "-description", "Do laundry"}
	out, _ = captureOutput(main)

	expected = `{"id":2,"status":"added"}
`
	if out != expected {
		t.Errorf("Expected %q, got %q", expected, out)
	}

	tasks, _ = LoadTasks()
	if len(tasks) != 2 || tasks[1].Description != "Do laundry" || tasks[1].ID != 2 {
		t.Errorf("Second task not saved correctly: %+v", tasks)
	}

	// Test invalid arguments (missing description)
	os.Args = []string{"cmd", "add", "-description", ""}
	exitCode := 0
	mainFunc := func() {
		defer func() {
			if r := recover(); r != nil {
				if e, ok := r.(int); ok {
					exitCode = e
				}
			}
		}()
		oldExit := os.Exit
		defer func() { os.Exit = oldExit }()
		os.Exit = func(code int) {
			panic(code)
		}
		main()
	}
	out, _ = captureOutput(mainFunc)

	expected = `{"error":"invalid arguments"}
`
	if out != expected || exitCode != 42 {
		t.Errorf("Expected %q with exit code 42, got %q with exit code %d", expected, out, exitCode)
	}
}

