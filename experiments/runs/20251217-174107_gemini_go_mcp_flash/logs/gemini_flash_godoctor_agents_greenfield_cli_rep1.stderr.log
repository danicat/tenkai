func TestDoneCommand(t *testing.T) {
	setupTestEnvironment()
	defer teardownTestEnvironment()

	// Add tasks for testing done command
	SaveTasks([]Task{
		{ID: 1, Description: "Task 1", Done: false},
		{ID: 2, Description: "Task 2", Done: false},
	})

	// Test completing an existing task
	os.Args = []string{"cmd", "done", "1"}
	out, _ := captureOutput(main)
	expected := `{"id":1,"status":"completed"}
`
	if out != expected {
		t.Errorf("Expected %q, got %q", expected, out)
	}

	// Verify task is marked done
	tasks, _ := LoadTasks()
	if len(tasks) != 2 || !tasks[0].Done {
		t.Errorf("Task 1 not marked as done: %+v", tasks)
	}

	// Test completing a non-existent task
	os.Args = []string{"cmd", "done", "99"}
	exitCode := 0
	mainFunc := func() {
		defer func() {
			if r := recover(); r != nil {
				if e, ok := r.(int); ok {
					exitCode = e
				}
			}
		}()
		oldExit := os.Exit
		defer func() { os.Exit = oldExit }()
		os.Exit = func(code int) {
			panic(code)
		}
		main()
	}
	out, _ = captureOutput(mainFunc)
	expected = `{"error":"task with ID 99 not found"}\n`
	if out != expected || exitCode != 42 {
		t.Errorf("Expected %q with exit code 42, got %q with exit code %d", expected, out, exitCode)
	}

	// Test invalid arguments (non-integer ID)
	os.Args = []string{"cmd", "done", "abc"}
	exitCode = 0 // Reset exit code
	out, _ = captureOutput(mainFunc)
	expected = `{"error":"invalid arguments"}\n`
	if out != expected || exitCode != 42 {
		t.Errorf("Expected %q with exit code 42, got %q with exit code %d", expected, out, exitCode)
	}
}

