// CreateBook adds a new book to the store.
func (s *Store) CreateBook(ctx context.Context, req CreateBookRequest) (Book, error) {
	if err := s.validator.Struct(req); err != nil {
		return Book{}, fmt.Errorf("validation failed: %w", err)
	}

	s.mu.Lock()
	defer s.mu.Unlock()

	id := uuid.New().String()
	book := Book{
		ID:    id,
		Title:  req.Title,
		Author: req.Author,
		Pages:  req.Pages,
	}

	s.books[id] = book
	return book, nil
}

