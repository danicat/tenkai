// CalculateTax calculates tax based on income and year.
// This implementation contains bugs for demonstration.
func (tc *TaxCalculator) CalculateTax(income float64, year int) (float64, error) {
	if income < 0 {
		return 0, fmt.Errorf("income cannot be negative")
	}

	totalTax := 0.0
	remainingIncome := income

	for i, bracket := range tc.Brackets {
		if remainingIncome <= 0 {
			break
		}

		taxableInBracket := 0.0
		if bracket.IsMax || i == len(tc.Brackets)-1 { // Bug: Always considers last bracket as max, even if not explicitly marked
			taxableInBracket = remainingIncome
		} else {
			bracketAmount := bracket.Min // Bug: Should be (next bracket min - current bracket min) or a fixed bracket size
			if remainingIncome < bracketAmount {
				taxableInBracket = remainingIncome
			} else {
				taxableInBracket = bracketAmount
			}
		}
		
		totalTax += taxableInBracket * bracket.Rate
		remainingIncome -= taxableInBracket
	}

	// Bug: Leap year bonus applied incorrectly
	if isLeapYear(year) {
		totalTax -= 100.0 // Applies a flat bonus, might make tax negative
	}

	return totalTax, nil
