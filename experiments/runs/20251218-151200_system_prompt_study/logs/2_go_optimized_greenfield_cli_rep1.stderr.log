		{ID: 3, Description: "Task 3", Done: false},
	})

	defer func() {
		if r := recover(); r != nil {
			if s, ok := r.(string); ok && s == "os.Exit wasalled with code: 0" {
				// Expected panic from mockExit
			} else {
				t.Fatalf("unexpected panic: %v", r)
			}
		}
	}()

	captureOutput()
	listTasks()
	output := stopCaptureOutput()

	expectedTasks := []Task{
		{ID: 1, Description: "Task 1", Done: false},
